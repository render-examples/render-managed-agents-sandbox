# Orchestrator (runs on a Render background worker or any host)
ANTHROPIC_ENVIRONMENT_ID=env_...
ANTHROPIC_ENVIRONMENT_KEY=sk-ant-oat01-...   # Console > Environments > Generate environment key
RENDER_API_KEY=rnd_...
RENDER_WORKSPACE_ID=tea-...

# Optional tuning
SANDBOX_TIMEOUT_SECONDS=3600     # hard cap on one session's sandbox (max 86400)
MAX_CONCURRENT_SESSIONS=20       # Render early access allows 100 concurrent sandboxes
SANDBOX_SNAPSHOT_NAME=claude-worker   # use a prebuilt snapshot with ant installed; falls back to base image
SANDBOX_NETWORK_POLICY=allow-list # allow-all, allow-list, or deny-all. deny-all blocks api.anthropic.com
SANDBOX_ALLOWED_DOMAINS=api.anthropic.com,pypi.org,files.pythonhosted.org
ANTHROPIC_SDK_VERSION=1.12.1
WORKER_MAX_IDLE=60s
SESSION_PERSISTENCE=snapshot     # snapshot (files), runtime (files, memory, setsid processes), or none
SANDBOX_PLAN=starter             # runtime snapshots restore only onto the same plan
KEEP_SANDBOXES=false             # true leaves sandboxes running after the session for debugging
FORWARD_ENVIRONMENT_KEY=false    # true also gives sandboxes the environment key; see GUIDE.md

# Only for scripts/e2e.py, run from your own machine. Never set on the orchestrator.
ANTHROPIC_API_KEY=sk-ant-api03-...
AGENT_ID=agent_...
